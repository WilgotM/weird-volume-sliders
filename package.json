{
  "name": "weird-volume-sliders",
  "version": "1.1.0",
  "private": true,
  "description": "Intentionally inconvenient sliders that control the real macOS and Windows output volume locally.",
  "main": "electron-main.js",
  "author": "WilgotM and Vivan Codes contributors",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64",
    "dist:windows": "electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "se.wilgotm.weird-volume-sliders",
    "productName": "Weird Volume Sliders",
    "copyright": "Copyright © 2026",
    "files": [
      "assets/**/*",
      "sliders/**/*",
      "electron-main.js",
      "server.js",
      "index.html",
      "sitemap.xml",
      "robots.txt",
      "bubbles-upgrade.png",
      "README.md",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "Weird-Volume-Sliders-Mac-${arch}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Weird-Volume-Sliders-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Weird Volume Sliders"
    }
  }
}
